{
  "name": "vizij-web",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "workspaces": [
    "packages/*",
    "packages/*/*",
    "apps/*"
  ],
  "scripts": {
    "dev:animation": "pnpm --filter demo-animation-studio run dev",
    "dev:graph": "pnpm --filter vizij-node-graph-editor run dev",
    "dev:website": "pnpm --filter vizij-website run dev",
    "dev:demo-animation": "pnpm --filter demo-animation run dev",
    "dev:demo-graph": "pnpm --filter demo-graph run dev",
    "dev:demo-render": "pnpm --filter demo-vizij-render run dev",
    "dev:demo-rigging": "pnpm --filter demo-vizij-rigging run dev",
    "dev:demo-orchestrator": "pnpm --filter demo-orchestrator run dev",
    "dev:demo-animation-graph": "pnpm --filter demo-animation-graph run dev",
    "dev:demo-animating-faces": "pnpm --filter demo-animating-faces run dev",
    "dev:demo-render-no-rig": "pnpm --filter demo-render-no-rig dev",
    "build": "pnpm -r run --if-present build",
    "build:packages": "pnpm --filter \"@vizij/utils\" run build && pnpm --filter \"@vizij/render\" run build && pnpm --filter \"@vizij/animation-react\" run build && pnpm --filter \"@vizij/node-graph-react\" run build && pnpm --filter \"@vizij/config\" run build && pnpm --filter \"@vizij/rig\" run build && pnpm --filter \"@vizij/orchestrator-react\" run build ",
    "build:apps": "pnpm --filter vizij-node-graph-editor run build && pnpm --filter demo-render-no-rig run build && pnpm --filter demo-animation-studio run build && pnpm --filter demo-animation run build && pnpm --filter demo-graph run build",
    "prettier:check": "pnpm -r run --if-present prettier:check",
    "prettier": "pnpm -r run --if-present prettier:write",
    "format": "pnpm run prettier",
    "format:check": "pnpm run prettier:check",
    "lint": "pnpm -r run --if-present lint",
    "test": "pnpm -r run --if-present test",
    "typecheck": "pnpm -r run --if-present typecheck",
    "typecheck:all": "pnpm -r --no-bail run --if-present typecheck",
    "clean": "pnpm -r run --if-present clean",
    "reset": "pnpm -r run --if-present reset && rm -rf node_modules",
    "reset:hard": "pnpm -r run --if-present reset:hard && rm -rf node_modules pnpm-lock.yaml",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "pnpm install --frozen-lockfile && pnpm run build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.2.4"
  }
}
