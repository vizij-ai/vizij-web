{
  "name": "vizij-web",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "workspaces": [
    "packages/*",
    "packages/*/*",
    "apps/*"
  ],
  "scripts": {
    "dev:demo-animation-studio": "pnpm --filter demo-animation-studio run dev",
    "dev:demo-graph-studio": "pnpm --filter demo-graph-studio run dev",
    "dev:vizij-authoring": "pnpm --filter vizij-authoring run dev",
    "dev:vizij-showcase": "pnpm --filter vizij-showcase run dev",
    "dev:demo-vizij-player": "pnpm --filter demo-vizij-player run dev",
    "dev:minimal-demo-animation": "pnpm --filter minimal-demo-animation run dev",
    "dev:minimal-demo-animation-graph": "pnpm --filter minimal-demo-animation-graph run dev",
    "dev:minimal-demo-graph": "pnpm --filter minimal-demo-graph run dev",
    "dev:minimal-demo-orchestrator": "pnpm --filter minimal-demo-orchestrator run dev",
    "dev:tutorial-agent-face": "pnpm --filter tutorial-agent-face run dev",
    "dev:tutorial-fullscreen-face": "pnpm --filter fullscreen-face run dev",
    "dev:vizij-standalone": "node scripts/check-snap-env.mjs && pnpm --filter vizij-standalone run dev",
    "build": "pnpm run build:packages && pnpm run build:apps",
    "build:packages": "pnpm --filter \"./packages/**\" run --if-present build",
    "build:apps": "pnpm --filter \"./apps/**\" run --if-present build",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "prep": "pnpm run format && pnpm run validate",
    "prep:all": "pnpm run format && pnpm run validate:all",
    "prep:push": "pnpm run format && pnpm run clean && pnpm run build && pnpm run validate:all",
    "lint": "./scripts/run-affected.sh lint",
    "lint:all": "pnpm -r run --if-present lint",
    "test": "./scripts/run-affected.sh test",
    "test:all": "pnpm -r run --if-present test",
    "typecheck": "./scripts/run-affected.sh typecheck",
    "typecheck:all": "pnpm -r --no-bail run --if-present typecheck",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "validate:all": "pnpm run lint:all && pnpm run typecheck:all && pnpm run test:all",
    "clean": "pnpm -r run --if-present clean",
    "reset": "pnpm -r run --if-present reset && rm -rf node_modules",
    "reset:hard": "pnpm -r run --if-present reset:hard && rm -rf node_modules pnpm-lock.yaml",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "verify:packages": "pnpm run build:packages && pnpm -r --filter \"@vizij/*\" run --if-present lint && pnpm -r --filter \"@vizij/*\" run --if-present test",
    "publish:packages": "pnpm exec changeset publish",
    "ci:version": "pnpm run version:packages",
    "ci:publish": "node ./scripts/ci-publish.mjs",
    "release:ci": "pnpm run verify:packages && pnpm run ci:publish",
    "release": "pnpm install --frozen-lockfile && pnpm run release:ci",
    "postinstall": "node ./scripts/wasm-links.mjs relink",
    "rebuild-nodes": "node ./scripts/rebuild-nodes.mjs",
    "wasm:status": "node ./scripts/wasm-links.mjs status",
    "wasm:link": "node ./scripts/wasm-links.mjs link",
    "wasm:unlink": "node ./scripts/wasm-links.mjs unlink"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "source-map": "0.7.4",
      "zustand": "5.0.9",
      "use-sync-external-store": "1.6.0"
    }
  }
}
