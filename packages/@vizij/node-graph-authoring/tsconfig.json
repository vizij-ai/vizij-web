{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2020",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "moduleResolution": "Bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "@vizij/node-graph-authoring": ["./src/index.ts"],
      "@vizij/utils": ["../utils/src/index.ts"],
      "@vizij/utils/*": ["../utils/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "build", "node_modules", "src/__tests__"]
}
