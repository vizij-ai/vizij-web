{
  "name": "@vizij/runtime-react",
  "description": "One Vizij face's lifecycle in React over @vizij/runtime: the provider, its store-change fan-out, value hooks and a JS tween.",
  "version": "0.4.2",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vizij-ai/vizij-web",
    "directory": "packages/@vizij/runtime-react"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts src/index.ts --external react,react-dom,@vizij/runtime,@vizij/render",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts src/index.ts --external react,react-dom,@vizij/runtime,@vizij/render",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx -- .",
    "lint:fix": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx --fix -- .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "NODE_ENV=test vitest --run --passWithNoTests",
    "clean": "rm -rf dist .turbo coverage tsconfig.tsbuildinfo",
    "reset": "rm -rf node_modules",
    "reset:hard": "pnpm run reset && rm -f pnpm-lock.yaml package-lock.json yarn.lock",
    "prepack": "pnpm run build && pnpm run test && pnpm run typecheck && pnpm run lint"
  },
  "peerDependencies": {
    "@vizij/render": "workspace:^",
    "@vizij/runtime": "^7.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vizij/render": "workspace:^",
    "@vizij/runtime": "^7.2.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.4.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "^8.0.1",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module"
}
