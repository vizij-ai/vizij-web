{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ES2020",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "..",
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "paths": {
      "@vizij/render": ["../render/src"],
      "@vizij/render/*": ["../render/src/*"],
      "@vizij/utils": ["../utils/src"],
      "@vizij/utils/*": ["../utils/src/*"]
    }
  },
  "include": ["src"]
}
