{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "declaration": true,
    "outDir": "dist",
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@vizij/render": ["../render/src"],
      "@vizij/render/*": ["../render/src/*"],
      "@vizij/utils": ["../utils/src"],
      "@vizij/utils/*": ["../utils/src/*"]
    }
  },
  "include": ["src"]
}
