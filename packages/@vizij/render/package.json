{
  "name": "@vizij/render",
  "description": "Vizij faces on a page: the shared canvas and face slots over @vizij/runtime's Bevy view, and the GLB loader, exporter and world model.",
  "version": "3.1.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vizij-ai/vizij-web",
    "directory": "packages/@vizij/render"
  },
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts src/index.tsx --external react,react-dom,three,zustand,@vizij/runtime",
    "dev": "tsup src/index.tsx --format esm,cjs --watch --dts src/index.tsx --external react,react-dom,three,zustand,@vizij/runtime",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx -- .",
    "lint:fix": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx --fix -- .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "node --import ./tests/register-ts-loader.mjs --test tests/*.node-test.mjs",
    "clean": "rm -rf dist .turbo coverage tsconfig.tsbuildinfo",
    "reset": "rm -rf node_modules",
    "reset:hard": "pnpm run reset && rm -f pnpm-lock.yaml package-lock.json yarn.lock",
    "size": "size-limit",
    "prepack": "pnpm run build && pnpm run test && pnpm run typecheck && pnpm run lint && pnpm run size"
  },
  "dependencies": {
    "@vizij/utils": "workspace:^",
    "immer": "^10.0.3",
    "three-stdlib": "^2.35.13"
  },
  "peerDependencies": {
    "@vizij/runtime": "^8.0.0 || ^9.0.0",
    "react": ">=18",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/three": "^0.170.0",
    "@size-limit/file": "^11.2.0",
    "react": "^19.2.3",
    "size-limit": "^11.1.7",
    "three": "^0.170.0",
    "zustand": "^5.0.2",
    "tsup": "^8.0.1",
    "typescript": "^5.5.0",
    "prettier": "^3.4.2",
    "@vizij/runtime": "^9.0.2",
    "react-dom": "^19.2.3",
    "@types/react-dom": "^19.2.3"
  },
  "size-limit": [
    {
      "name": "renderer",
      "path": "dist/index.js",
      "limit": "70 KB"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
