{
  "name": "@vizij/rig",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx -- .",
    "lint:fix": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx --fix -- .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "vitest --run --passWithNoTests",
    "clean": "rm -rf dist coverage tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "reset": "rm -rf node_modules",
    "reset:hard": "pnpm run reset && rm -f pnpm-lock.yaml package-lock.json yarn.lock"
  },
  "dependencies": {
    "@vizij/config": "workspace:*",
    "@vizij/render": "workspace:*",
    "@vizij/utils": "workspace:*",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/react": "^18.2.0",
    "prettier": "^3.4.2",
    "vitest": "^3.2.4"
  }
}
