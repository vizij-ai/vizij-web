{
  "name": "@vizij/node-graph-react",
  "version": "0.2.1",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vizij-ai/vizij-web",
    "directory": "packages/@vizij/node-graph-react"
  },
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external react,@vizij/node-graph,@vizij/value-json",
    "build": "tsup src/index.ts --format esm,cjs --dts --external react,@vizij/node-graph,@vizij/value-json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx -- .",
    "lint:fix": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx --fix -- .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "NODE_ENV=test vitest --run --passWithNoTests",
    "clean": "rm -rf dist coverage tsconfig.tsbuildinfo",
    "reset": "rm -rf node_modules",
    "reset:hard": "pnpm run reset && rm -f pnpm-lock.yaml package-lock.json yarn.lock",
    "prepack": "pnpm run build && pnpm run test && pnpm run typecheck"
  },
  "dependencies": {
    "@vizij/node-graph": "^0.7.0",
    "@vizij/value-json": "^0.2.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.7",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7",
    "prettier": "^3.4.2",
    "react-dom": "^19.2.3",
    "tsup": "^8.0.1",
    "react": "^19.2.3",
    "@testing-library/dom": "^10.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
