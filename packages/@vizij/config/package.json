{
  "name": "@vizij/config",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external @vizij/utils",
    "build": "tsup src/index.ts --format esm,cjs --dts --external @vizij/utils",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx -- .",
    "lint:fix": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx --fix -- .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "vitest --run --passWithNoTests",
    "clean": "rm -rf dist coverage tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "reset": "rm -rf node_modules",
    "reset:hard": "pnpm run reset && rm -f pnpm-lock.yaml package-lock.json yarn.lock",
    "prepack": "pnpm run build && pnpm run test && pnpm run typecheck"
  },
  "dependencies": {
    "@vizij/utils": "workspace:*"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "vitest": "^3.2.4",
    "tsup": "^8.0.1",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
