{
  "name": "@vizij/studio-support",
  "description": "Studio-canonical asset preparation helpers for Vizij runtimes and authoring surfaces.",
  "version": "0.1.0",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vizij-ai/vizij-web",
    "directory": "packages/@vizij/studio-support"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts src/index.ts",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx -- .",
    "lint:fix": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx --fix -- .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "NODE_ENV=test vitest --run --passWithNoTests",
    "clean": "rm -rf dist .turbo coverage tsconfig.tsbuildinfo",
    "reset": "rm -rf node_modules",
    "reset:hard": "pnpm run reset && rm -f pnpm-lock.yaml package-lock.json yarn.lock",
    "prepack": "pnpm run build && pnpm run test && pnpm run typecheck && pnpm run lint"
  },
  "dependencies": {
    "@vizij/node-graph-authoring": "workspace:*",
    "@vizij/node-graph-wasm": "^0.6.1",
    "@vizij/orchestrator-wasm": "^0.3.2",
    "@vizij/utils": "workspace:*"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "tsup": "^8.0.1",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module"
}
