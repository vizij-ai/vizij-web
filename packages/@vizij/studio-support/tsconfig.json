{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "declaration": true,
    "outDir": "dist",
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@vizij/node-graph-authoring": ["../node-graph-authoring/src"],
      "@vizij/node-graph-authoring/*": ["../node-graph-authoring/src/*"],
      "@vizij/utils": ["../utils/src"],
      "@vizij/utils/*": ["../utils/src/*"]
    }
  },
  "include": ["src"]
}
