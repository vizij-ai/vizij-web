{
  "name": "@vizij/utils",
  "description": "Shared typescript utilities.",
  "version": "0.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts src/index.ts --external react",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts src/index.ts --external react",
    "test": "vitest --passWithNoTests",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "react": "^18.3.1"
  }
}
