{
  "name": "@vizij/render",
  "description": "Higher-level visualization and interaction components for robot and ai faces.",
  "version": "0.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts src/index.tsx --external react",
    "dev": "tsup src/index.tsx --format esm,cjs --watch --dts src/index.tsx --external react",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx -- .",
    "lint:fix": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx --fix -- .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "vitest --run --passWithNoTests",
    "clean": "rm -rf dist .turbo coverage tsconfig.tsbuildinfo",
    "reset": "rm -rf node_modules",
    "reset:hard": "pnpm run reset && rm -f pnpm-lock.yaml package-lock.json yarn.lock"
  },
  "dependencies": {
    "@react-three/drei": "^9.115.0",
    "@react-three/fiber": "^8.17.10",
    "@semio/ui": "*",
    "@vizij/utils": "workspace:*",
    "clsx": "^2.1.1",
    "deep-equal": "^2.2.3",
    "immer": "^10.0.3",
    "lodash": "^4.17.21",
    "react-error-boundary": "^4.0.13",
    "three": "^0.170.0",
    "three-stdlib": "^2.35.13",
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.3"
  },
  "devDependencies": {
    "@types/deep-equal": "^1.0.4",
    "@types/lodash": "^4.17.4",
    "@types/react": "^18.3.1",
    "@types/three": "^0.170.0",
    "react": "^18.3.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "prettier": "^3.4.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
