#!/usr/bin/env bash
# Git pre-push hook for vizij-web: targeted lint/type/test runs and optional builds
set -euo pipefail

if [[ "${SKIP_GIT_HOOKS:-0}" == "1" ]]; then
  echo "[vizij-web pre-push] SKIP_GIT_HOOKS=1 -> skipping checks"
  exit 0
fi

BASE_MSG="${PNPM_BASE_REF:-auto-upstream}"
echo "[vizij-web pre-push] pnpm run validate (base: ${BASE_MSG})"
CI=1 pnpm run validate

# Optional: run additional builds to catch bundling/tsconfig issues early
if [[ "${HOOK_RUN_WEB_BUILD:-0}" == "1" ]]; then
  echo "[vizij-web pre-push] Extra build (HOOK_RUN_WEB_BUILD=1)"
  pnpm run build
fi

echo "[vizij-web pre-push] OK"
