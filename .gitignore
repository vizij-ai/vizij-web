# installs & caches
**/node_modules/
**/.vite/
**/.turbo/        # if you ever use turbo
**/dist/

# env
.env
*.env.local
.env.*.local

# tarballs from npm pack
*.tgz

# common editor cruft
.DS_Store
*.log
.idea/
.vscode/
.eslintcache
.claude/settings.local.json
.worktrees/

# Rust / Cargo build output (nested crates, incl. Tauri src-tauri and arora-* packages)
**/target/

# Tauri auto-generated capability/ACL schemas (regenerated on build)
**/src-tauri/gen/schemas/

# Playwright run output (traces/videos/diffs).
**/test-results/
**/playwright-report/
**/.playwright/
