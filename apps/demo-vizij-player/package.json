{
  "name": "demo-vizij-player",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx -- .",
    "lint:fix": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx --fix -- .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "vitest --run --passWithNoTests",
    "clean": "rm -rf dist .vite coverage tsconfig.tsbuildinfo",
    "reset": "rm -rf node_modules",
    "reset:hard": "pnpm run reset && rm -f pnpm-lock.yaml package-lock.json yarn.lock"
  },
  "dependencies": {
    "@vizij/animation-react": "workspace:*",
    "@vizij/orchestrator-react": "workspace:*",
    "@vizij/render": "workspace:*",
    "@vizij/utils": "workspace:*",
    "@vizij/value-json": "^0.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
