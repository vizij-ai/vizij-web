{
  "name": "demo-graph-studio",
  "version": "0.1.5",
  "private": true,
  "description": "Demo Node Graph Editor app — built on @vizij/node-graph-react and node-graph",
  "main": "src/main.tsx",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx -- .",
    "lint:fix": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx --fix -- .",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "NODE_ENV=test vitest --run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .vite coverage tsconfig.tsbuildinfo",
    "reset": "rm -rf node_modules",
    "reset:hard": "pnpm run reset && rm -f pnpm-lock.yaml package-lock.json yarn.lock"
  },
  "dependencies": {
    "@vizij/node-graph": "^0.13.0",
    "@vizij/node-graph-authoring": "workspace:*",
    "@vizij/node-graph-react": "workspace:*",
    "@vizij/utils": "workspace:*",
    "@vizij/value-json": "^0.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "reactflow": "11.x",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "vizij",
    "node-graph",
    "editor",
    "react",
    "reactflow"
  ],
  "author": "Vizij",
  "license": "Apache-2.0"
}
