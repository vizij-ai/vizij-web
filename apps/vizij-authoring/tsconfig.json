{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@vizij/node-graph-authoring": [
        "../../packages/@vizij/node-graph-authoring/src/index.ts"
