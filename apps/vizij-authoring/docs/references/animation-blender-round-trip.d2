# Render: d2 --font-regular <Questrial-Regular.ttf> \
#           docs/references/animation-blender-round-trip.d2 \
#           docs/references/animation-blender-round-trip.svg
#
# Verified against Blender 5.2.1 on 2026-09-08. See the .md alongside for the
# measurements and the decision this reflects.

vars: { d2-config: { theme-id: 0; pad: 24; sketch: false; layout-engine: dagre } }

classes: {
  primary:   { style: { fill: "#50C4B6"; stroke: "#2AA499"; font-color: "#FFFFFF"; border-radius: 8; stroke-width: 2 } }
  secondary: { style: { fill: "#F56B29"; stroke: "#EC4D00"; font-color: "#FFFFFF"; border-radius: 8; stroke-width: 2 } }
  highlight: { style: { fill: "#FF9E00"; stroke: "#F78600"; font-color: "#333333"; border-radius: 8; stroke-width: 2 } }
  neutral:   { style: { fill: "#F7F8F8"; stroke: "#888888"; font-color: "#333333"; border-radius: 8; stroke-width: 2 } }
  emphasis:  { style: { fill: "#48E2CE"; stroke: "#2AA499"; font-color: "#111111"; border-radius: 8; stroke-width: 2 } }
  group:     { style: { fill: "#FFFFFF"; stroke: "#50C4B6"; font-color: "#333333"; border-radius: 8; stroke-width: 2 } }
  declined:  { style: { fill: "#FFFFFF"; stroke: "#EC4D00"; font-color: "#EC4D00"; border-radius: 8; stroke-width: 2; stroke-dash: 4 } }
}

title: "Animations in and out of Vizij" {
  near: top-center
  shape: text
  style: { font-size: 32; bold: true; font-color: "#333333" }
}

blender: "Blender, and any other glTF tool" {
  class: group
  direction: down

  authored: "Animation authored\nin Blender" { class: secondary }
  views: "Opens the .glb and\nplays the baked motion" { class: secondary }
}

glb: "The .glb Vizij writes" {
  class: group
  direction: down

  channels: "glTF animation channels\nbaked, so any tool can play it" { class: neutral }
  bundle: "VIZIJ_bundle.animations\nlossless clips, the source of truth" { class: emphasis }
  records: "VIZIJ_bundle.bakedAnimations\nclipId + fingerprint" { class: highlight }
  robot: "RobotData\nrig + baked rootBounds" { class: emphasis }

  channels -> records: "hash what was written"
}

vizij: "Vizij" {
  class: group
  direction: down

  timeline: "Timeline editor" { class: primary }

  compare: "Reopening a Vizij-written .glb:\nis there a fingerprint record?" {
    class: highlight
    shape: diamond
  }

  skip: "match -> skip-duplicate\nthe bundle clip loads once,\nthe baked copy is dropped" { class: primary }
  fresh: "no record -> import-new\nimport as a new clip alongside\nwhatever is already open" { class: neutral }
  both: "mismatch -> keep-both-edited\nreachable only if the bundle\nsurvived the edit" { class: declined }

  compare -> skip
  compare -> fresh
  compare -> both
}

# --- in ----------------------------------------------------------------------
blender.authored -> vizij.timeline: "import a .glb, or import\nits animations on their own" { style.stroke: "#555555" }

# --- out ---------------------------------------------------------------------
vizij.timeline -> glb.bundle: "save" { style.stroke: "#555555" }
vizij.timeline -> glb.channels: "save (bake)" { style.stroke: "#555555" }
glb.channels -> blender.views: "one way: to be seen, not brought back" { style.stroke: "#555555" }

# --- reopening our own file --------------------------------------------------
glb.records -> vizij.compare { style.stroke: "#555555" }
glb.bundle -> vizij.timeline: "load lossless" { style.stroke: "#555555" }

# --- the path deliberately not taken ----------------------------------------
back: "Editing the baked animation in Blender\nand re-exporting is NOT a supported route.\nBlender's exporter drops every extension, so its\noutput has no bundle, no records and no RobotData.\nPreserving them would need a Blender-specific\nadd-on, which we have chosen not to build." {
  class: declined
}
blender.views -> back { style: { stroke: "#EC4D00"; stroke-dash: 4 } }

note: "Measured against Blender 5.2.1. A save writes each clip twice: losslessly into VIZIJ_bundle, which is the source of truth, and baked into\nglTF channels so other tools can play the motion. The bake is one way by design. The animation-only import still works for any glTF\nanimation from any tool -- it lands as import-new, a new clip beside the existing ones -- it just is not a round trip Vizij designs for." {
  near: bottom-center
  shape: text
  style: { font-size: 14; font-color: "#555555" }
}
