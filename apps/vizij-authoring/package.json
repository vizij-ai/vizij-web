{
  "name": "vizij-authoring",
  "private": true,
  "version": "0.4.1",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "CI=1 storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx -- .",
    "lint:fix": "pnpm --filter \"$npm_package_name\" exec eslint --ext .js,.jsx,.ts,.tsx --fix -- .",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "test": "NODE_ENV=test vitest --run --passWithNoTests",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:smoke": "playwright test --config=playwright.config.ts --project=smoke",
    "test:e2e:debug": "PWDEBUG=1 playwright test --config=playwright.config.ts --project=smoke --project=workflow --headed --trace on --video on",
    "test:e2e:memory:preview": "VIZIJ_MEMORY_SERVER_MODE=preview playwright test --config=playwright.config.ts e2e/memory-investigation.workflow.pw.ts",
    "test:e2e:memory:dev": "VIZIJ_E2E_SERVER_MODE=dev VIZIJ_MEMORY_SERVER_MODE=dev playwright test --config=playwright.config.ts e2e/memory-investigation.workflow.pw.ts",
    "perf:inputs-baseline": "VIZIJ_CAPTURE_PERF=1 vitest --run src/components/panels/VariablesPanel.perf.test.tsx --reporter=verbose",
    "clean": "rm -rf dist .vite coverage tsconfig.tsbuildinfo storybook-static",
    "reset": "rm -rf node_modules",
    "reset:hard": "pnpm run reset && rm -f pnpm-lock.yaml package-lock.json yarn.lock",
    "graph:components": "node scripts/component-graph.mjs layers --into docs/references/component-graph.md && node scripts/component-graph.mjs detail --into docs/references/component-graph.md"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.17.0",
    "@semio/ui": "0.4.0",
    "@tabler/icons-react": "^3.50.0",
    "@vizij/node-graph": "^0.13.0",
    "@vizij/node-graph-authoring": "workspace:*",
    "@vizij/node-graph-react": "workspace:*",
    "@vizij/render": "workspace:*",
    "@vizij/runtime": "^9.2.0",
    "@vizij/runtime-react": "workspace:*",
    "@vizij/utils": "workspace:*",
    "@vizij/value-json": "^0.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.64.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.1",
    "reactflow": "11.x",
    "tailwind-merge": "^3.7.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "storybook": "10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
