{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@vizij/utils": ["../../packages/@vizij/utils/src"],
      "@vizij/utils/*": ["../../packages/@vizij/utils/src/*"]
    }
  }
}
